# Server
PORT=3000

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=plagiarism_detector

# Ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_EMBED_MODEL=nomic-embed-text

# Scanning behaviour
MAX_UPLOAD_MB=40
CHUNK_WORDS=120
CHUNK_OVERLAP_WORDS=25
MAX_CHUNKS=400
MATCH_THRESHOLD=40
TOP_CANDIDATE_SOURCES=25

# Online scholarly sources
ENABLE_WEB_SOURCES=true
CROSSREF_MAILTO=you@example.com
WEB_QUERIES=4
WEB_RESULTS_PER_QUERY=10