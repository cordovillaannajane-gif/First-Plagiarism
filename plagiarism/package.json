{
  "name": "pdf-plagiarism-detector",
  "version": "1.0.0",
  "private": true,
  "description": "Local PDF plagiarism detection system using Node.js, Express, MySQL and Ollama embeddings. Similarity-based only, no third-party plagiarism APIs.",
  "main": "server/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "init-db": "node scripts/init-db.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.11.0",
    "pdf-parse": "^1.1.1"
  },
  "engines": {
    "node": ">=18"
  }
}
